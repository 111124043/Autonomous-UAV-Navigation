<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_flow'>

    <self_collide>false</self_collide>
    <enable_wind>false</enable_wind>
    <static>false</static>

    <!-- Base drone -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Optical Flow -->
    <include merge='true'>
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">0.03 0 -0.10 0 0 0</pose>
    </include>

    <!-- LW20 Rangefinder -->
    <include merge='true'>
      <uri>model://LW20</uri>
      <pose relative_to="base_link">0 0 -0.079 0 1.57 0</pose>
    </include>

    <!-- Optical Flow Joint -->
    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
      <pose relative_to="base_link">0 0 -0.10 0 1.5707 0</pose>
    </joint>

    <!-- LW20 Joint -->
    <joint name="lidar_model_joint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <!-- Front RGB Camera -->
    <link name="front_camera_link">

      <pose relative_to="base_link">0.35 0 0.12 0 0 0</pose>

      <inertial>
        <mass>0.01</mass>

        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="front_camera" type="rgbd_camera">
      
          <gz_frame_id>front_camera_link</gz_frame_id>

          <always_on>true</always_on>

          <update_rate>30</update_rate>

          <visualize>true</visualize>

          <topic>front_camera</topic>

          <camera>

            <horizontal_fov>1.204</horizontal_fov>

            <image>

              <width>640</width>

              <height>480</height>

              <format>R8G8B8</format>

            </image>

            <clip>

              <near>0.05</near>

              <far>20</far>

            </clip>

          </camera>

          <depth_camera>

            <clip>

              <near>0.05</near>

              <far>20.0</far>

            </clip>

          </depth_camera>

        </sensor>

    </link>

    <!-- Camera Joint -->
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <!-- Simulated Downward Lidar -->
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <link name="lidar_sensor_link">

      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>

      <inertial>
        <mass>0.001</mass>

        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <sensor name='lidar' type='gpu_lidar'>

        <gz_frame_id>lidar_sensor_link</gz_frame_id>

        <pose>0 0 0 3.14 0 0</pose>

        <update_rate>50</update_rate>

        <ray>

          <scan>

            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>

          </scan>

          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>

        </ray>

        <always_on>1</always_on>

        <visualize>true</visualize>

      </sensor>

    </link>

  </model>
</sdf>
